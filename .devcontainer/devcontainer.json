{
  "name": "Japan x402 APIs",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm install && cp .env.example .env.local",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteEnv": {
    "WALLET_ADDRESS": "${localEnv:WALLET_ADDRESS}",
    "FACILITATOR_URL": "${localEnv:FACILITATOR_URL}",
    "CRYPTOPANIC_API_TOKEN": "${localEnv:CRYPTOPANIC_API_TOKEN}"
  }
}
