# =============================================================================
# Japan x402 APIs - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# cp .env.example .env.local

# =============================================================================
# REQUIRED: Your wallet address to receive x402 micropayments (Base Sepolia)
# =============================================================================
# Get a wallet address from:
#   - Coinbase Wallet: https://wallet.coinbase.com
#   - MetaMask: https://metamask.io
#   - Or create one with: npx cdp wallet create
WALLET_ADDRESS=0xYourWalletAddressHere

# =============================================================================
# OPTIONAL: x402 Facilitator URL
# Default: https://x402.org/facilitator (Coinbase-hosted, testnet)
# =============================================================================
FACILITATOR_URL=https://x402.org/facilitator

# =============================================================================
# OPTIONAL: CryptoPanic API token (for APAC crypto news endpoint)
# Without this, the API falls back to mock news data.
# Get a free token at: https://cryptopanic.com/developers/api/
# =============================================================================
CRYPTOPANIC_API_TOKEN=

# =============================================================================
# OPTIONAL: ExchangeRate-API key (for FX endpoint)
# The free plan at open.er-api.com works without an API key.
# For higher rate limits, get a key at: https://www.exchangerate-api.com
# =============================================================================
# EXCHANGERATE_API_KEY=

# =============================================================================
# MAINNET MIGRATION
# When moving to mainnet, change FACILITATOR_URL to the mainnet facilitator
# and update WALLET_ADDRESS to your mainnet wallet.
# See README.md for full mainnet migration instructions.
# =============================================================================
